# Copy to .env for local development. Never put real credentials here.

# development | test | sandbox | production
APP_ENV=development

# Address the API listens on, and the separate metrics listener.
HTTP_ADDR=:8080
METRICS_ADDR=:9090

# debug | info | warn | error
LOG_LEVEL=debug

# PostgreSQL. Deployed environments require sslmode=require or stricter.
DATABASE_URL=postgres://axene:axene_dev_only@localhost:5432/axene?sslmode=disable

# HTTP server timeouts (Go duration syntax). The write timeout must exceed
# PROVIDER_TIMEOUT because creating a payment waits for the provider call.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
PROVIDER_TIMEOUT=30s

# Keys the HMAC that stores API keys. At least 32 characters. In deployed
# environments this comes from the secret store; rotating it invalidates
# every API key.
API_KEY_PEPPER=dev-only-pepper-change-me-0123456789abcdef

# Externally reachable base URL that providers call back, and the secret
# path token in callback URLs (at least 32 of A-Z a-z 0-9 _ -).
PUBLIC_BASE_URL=http://localhost:8080
CALLBACK_TOKEN=dev_only_callback_token_0123456789abcdef

# SIMULATED provider for development (refused in production).
TESTPROVIDER_ENABLED=true
TESTPROVIDER_CALLBACK_SECRET=dev-only-testprovider-secret

# Worker.
RABBITMQ_URL=amqp://axene:axene_dev_only@localhost:5672/
WORKER_POLL_INTERVAL=1s

# Integration tests create and drop throwaway databases through this role.
TEST_DATABASE_URL=postgres://axene:axene_dev_only@localhost:5432/axene_test?sslmode=disable
